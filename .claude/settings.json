            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"C:/Users/Diarmuid/brain/plugins/cortex/scripts/cortex_check.py\" --hook",
